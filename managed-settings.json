{
  "permissions": {
    "deny": [
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/usr/local/bin/push-guard.sh" }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
