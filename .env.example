# Copy to .env and set this machine's folders (forward slashes). .env is not committed.
# Example: lab PC with the layout in flake_catalog/docs/LAB_PC_SETUP.md
REPO_DIR=C:/path/to/flake_catalog
RAW_DIR=D:/flake_raw
DERIVED_DIR=D:/flake_derived
SCRATCH_DIR=D:/flake-scratch
KLAYOUT_WORK_DIR=D:/klayout_work
KLAYOUTCLAW_DIR=C:/path/to/KlayoutClaw
GIT_NAME=your-github-name
GIT_EMAIL=you@example.com

# Docker inside WSL (no Docker Desktop): the *_DIR paths above must be WSL paths
# (C:/... -> /mnt/c/..., D:/... -> /mnt/d/...), and these give the Windows paths that
# workbook links are written with, so they open in Excel:
# REPO_LINK=C:/path/to/flake_catalog
# RAW_LINK=D:/flake_raw
# DERIVED_LINK=D:/flake_derived
